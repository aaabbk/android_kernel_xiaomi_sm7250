# Compile-time checks and compiler options
CONFIG_FRAME_WARN=4096

# CPUSET
CONFIG_CPUSET_ASSIST=y
CONFIG_CPUSET_AUDIO_APP="0-5"
CONFIG_CPUSET_BG="0-5"
CONFIG_CPUSET_CAMERA="0-5"
CONFIG_CPUSET_DISPLAY="0-7"
CONFIG_CPUSET_FG="0-7"
CONFIG_CPUSET_RESTRICTED="0-5"
CONFIG_CPUSET_SYSTEM_BG="0-5"

# Input Device Drivers
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_NEW_PEN_CONNECT_STRATEGY=y
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
# CONFIG_TOUCHSCREEN_FTS is not set
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FP_VREG_CONTROL=y
# CONFIG_FPR_FPC is not set

# TI Technologies, Inc. Charger support
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_ONEWIRE_GPIO=y

# Media drivers
CONFIG_MI7250_CAMERA=y

# Multifunction device drivers
CONFIG_IR_SPI=y
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# Pseudo filesystems
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
#CONFIG_PSTORE_LAST_KMSG=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y

# Qualcomm RmNet extensions
CONFIG_RMNET_PERF=y
CONFIG_RMNET_SHS=y

# Qualcomm Atheros CLD WLAN module
CONFIG_QCA_CLD_WLAN=y

# RCU Subsystem
CONFIG_LOG_BUF_SHIFT=21

# USB GPIO expanders
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_G7A_CHG=y

# Xiaomi Family
CONFIG_BOARD_XIAOMI=y
CONFIG_BOARD_XIAOMI_SM7250=y
CONFIG_BOARD_PICASSO=y
CONFIG_XIAOMI_MIUI=y
CONFIG_PACKAGE_RUNTIME_INFO=y
CONFIG_MIGT=y
CONFIG_MILLET=y
CONFIG_MIGT_ENERGY_MODEL=y
CONFIG_PERF_HUMANTASK=y
CONFIG_PERF_CRITICAL_RT_TASK=y
CONFIG_SF_BINDER=y
CONFIG_MIUI_ZRAM_MEMORY_TRACKING=y
CONFIG_MI_FRAGMENTION=y

# Cgroup v2 controllers
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_MISC=y

# Android 17 BPF stack
# netbpfload refuses to boot (reboot,bpfloader-failed) unless uname reports
# at least 5.10; this tree already carries the matching BPF feature set.
CONFIG_KERNEL_RELEASE_OVERRIDE="5.10.199"
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_NET_ACT_BPF=y
CONFIG_BPF_STREAM_PARSER=y
